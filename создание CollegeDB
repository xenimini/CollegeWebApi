Как создать базу CollegeDB

1. Открой SQL Server Management Studio (SSMS).
2. Подключись к серверу localhost\SQLEXPRESS (Windows Authentication).
3. Нажми Создать запрос.
4. Вставь полный SQL-скрипт (который ниже).
5. Нажми Выполнить (F5).

После выполнения база `CollegeDB` будет создана со всеми таблицами и тестовыми данными.




-- Удаляем старую базу, если есть
IF DB_ID('CollegeDB') IS NOT NULL
BEGIN
    ALTER DATABASE CollegeDB SET SINGLE_USER WITH ROLLBACK IMMEDIATE;
    DROP DATABASE CollegeDB;
END
GO

CREATE DATABASE CollegeDB;
GO

USE CollegeDB;
GO

-- Группы
CREATE TABLE Groups (
    Id INT IDENTITY(1,1) PRIMARY KEY,
    Name NVARCHAR(100) NOT NULL
);

-- Студенты
CREATE TABLE Students (
    Id INT IDENTITY(1,1) PRIMARY KEY,
    FirstName NVARCHAR(50) NOT NULL,
    LastName NVARCHAR(50) NOT NULL,
    Age INT NULL,
    GroupId INT NULL,
    CONSTRAINT FK_Students_Groups FOREIGN KEY (GroupId) REFERENCES Groups(Id)
);

-- Преподаватели
CREATE TABLE Teachers (
    Id INT IDENTITY(1,1) PRIMARY KEY,
    FirstName NVARCHAR(50) NOT NULL,
    LastName NVARCHAR(50) NOT NULL
);

-- Предметы
CREATE TABLE Subjects (
    Id INT IDENTITY(1,1) PRIMARY KEY,
    Name NVARCHAR(100) NOT NULL,
    TeacherId INT NULL,
    CONSTRAINT FK_Subjects_Teachers FOREIGN KEY (TeacherId) REFERENCES Teachers(Id)
);

-- Оценки
CREATE TABLE Grades (
    Id INT IDENTITY(1,1) PRIMARY KEY,
    StudentId INT NOT NULL,
    SubjectId INT NOT NULL,
    Score INT NOT NULL,
    GradeDate DATE NOT NULL DEFAULT GETDATE(),
    CONSTRAINT FK_Grades_Students FOREIGN KEY (StudentId) REFERENCES Students(Id),
    CONSTRAINT FK_Grades_Subjects FOREIGN KEY (SubjectId) REFERENCES Subjects(Id)
);
GO

